{
  "name": "academic-mongo-rest-api",
  "version": "1.0.0",
  "description": "My second Web Services node project",
  "main": "dist/src/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && node dist/src/server.js",
    "dev": "tsx watch src/server.ts",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "test": "npm run build && node --test dist/test/*.test.js",
    "swagger:generate": "node swagger.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hectapia/academic-mongo-rest-api.git"
  },
  "author": "Hector Olivares Tapia",
  "license": "ISC",
  "dependencies": {
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-session": "^1.18.0",
    "mongodb": "^6.5.0",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "swagger-autogen": "^2.23.7",
    "swagger-ui-express": "^5.0.0",
    "validatorjs": "^3.22.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/express-session": "^1.19.0",
    "@types/node": "^20.19.43",
    "@types/passport": "^1.0.17",
    "@types/passport-github2": "^1.2.9",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/validatorjs": "^3.15.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
